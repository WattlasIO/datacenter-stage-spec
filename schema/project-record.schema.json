{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WattlasIO/datacenter-stage-spec/main/schema/project-record.schema.json",
  "title": "Pre-Operational Data Center Project Record",
  "description": "Open interchange format for tracking a planned or under-construction US data center campus with explicit stage proof and capacity basis.",
  "type": "object",
  "required": [
    "project_name",
    "state",
    "stage",
    "observed_date",
    "evidence"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 2,
      "description": "Display name of the campus or phase."
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Two-letter US state or DC postal code."
    },
    "county": {
      "type": "string",
      "minLength": 2,
      "description": "County or county-equivalent name."
    },
    "city": {
      "type": "string",
      "description": "City or town name, if incorporated."
    },
    "owner_or_developer": {
      "type": "string",
      "description": "Named developer, operator, or project LLC shown in filings."
    },
    "stage": {
      "type": "string",
      "enum": [
        "announced",
        "zoning_filed",
        "zoning_approved",
        "site_permit",
        "building_permit",
        "under_construction",
        "energized"
      ],
      "description": "Furthest lifecycle stage supported by the attached evidence."
    },
    "capacity": {
      "type": "object",
      "required": ["basis"],
      "properties": {
        "mw": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "description": "Megawatt figure stated in the record, or null if undisclosed."
        },
        "basis": {
          "type": "string",
          "enum": [
            "it_load_mw",
            "utility_load_mw",
            "interconnection_request_mw",
            "generation_nameplate_mw",
            "undisclosed"
          ],
          "description": "What the reported megawatt number actually measures."
        }
      },
      "additionalProperties": false
    },
    "observed_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date (YYYY-MM-DD) when the record was verified."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record_type", "url", "filed_date", "summary"],
        "properties": {
          "record_type": {
            "type": "string",
            "enum": [
              "press_release",
              "zoning_application",
              "zoning_approval",
              "site_plan_permit",
              "environmental_permit",
              "utility_filing",
              "incentive_agreement",
              "building_permit",
              "construction_notice",
              "energization_notice"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "filed_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "summary": {
            "type": "string",
            "minLength": 5
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
